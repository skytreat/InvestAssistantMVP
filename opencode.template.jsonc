{
  "$schema": "https://opencode.ai/config.json",
  "model": "agnes/agnes-2.5-flash",
  "provider": {
    "agnes": {
      "name": "Agnes",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.agnes-ai.cn/v1",
        "apiKey": "sk-API-key"
      },
      "models": {
        "agnes-2.5-flash": {},
        "agnes-2.5-pro": {}
      }
    }
  },
  "permission": {
    "bash": "ask",
    "read": "allow",
    "edit": "allow",
    "glob": "allow"
  },
  "agent": {
    "context": {
      "exclude": [
        "node_modules/**",
        "dist/**",
        "build/**",
        ".git/**",
        "*.db",
        "*.duckdb"
      ]
    }
  },
  "ui": {
    "showSkillLoadInfo": false
  }
}
