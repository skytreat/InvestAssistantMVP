# 由 deploy/deploy.sh 渲染：__CADDY_DOMAIN__ / __CADDY_EMAIL__
# 不要直接复制本文件；脚本会校验并安装到 /etc/caddy/Caddyfile。
:80 {
	# HTTP 明文入口 → 一律 301 到 HTTPS（SDD §10.3 SE1）
	redir https://__CADDY_DOMAIN__{uri} permanent
}

__CADDY_DOMAIN__ {
	tls __CADDY_EMAIL__

	# /api/* 反代到 Fastify 后端（只监听 127.0.0.1:8080）
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	# 前端 SPA 静态资源（Vite build 产物）
	# SPA history mode 兜底：所有非文件路径都返回 index.html
	handle {
		root * /opt/invol/IA_Prod/frontend/dist
		try_files {path} /index.html
		encode zstd gzip
		file_server
	}
}
