[Unit]
Description=InvestAssistant Fastify 后端
After=network-online.target tdx2db.service
Wants=network-online.target tdx2db.service

[Service]
Type=simple
User=invol
Group=invol
WorkingDirectory=/opt/invol
ExecStart=/usr/bin/node /opt/invol/dist/server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=/opt/invol/.env.local
StandardOutput=journal
StandardError=journal

# 安全硬约束：只监听 127.0.0.1
# 实际监听在 Fastify 代码里配置，这里只是提醒
# Caddy 反代到 127.0.0.1:8080

[Install]
WantedBy=multi-user.target
