[Unit]
Description=InvestAssistant Fastify 后端
After=network-online.target
Wants=network-online.target
# 进程最终失败（Restart 次数耗尽）时推送企业微信；行情链路的失败由 Fastify cron 在 17:01 告警
OnFailure=invest-alert@%N.service

[Service]
Type=simple
User=invol
Group=invol
WorkingDirectory=/opt/invol/IA_Prod/app
ExecStart=/usr/bin/node /opt/invol/IA_Prod/app/dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Environment=NODE_ENV=production
# ADR-026：asset_class 增量初判**落库**开关（默认 dry-run 只算不写）。
#   生产置 execute ⇒ 券商导入 / 手工录入后自动补齐「现金类」分类（逆回购/货币 ETF）。
#   ⚠️ 首次上线仍需跑一次回填：`npx tsx src/cli/assetClassSync.ts --execute`（详见 docs/deploy.md）。
Environment=ASSET_CLASS_SYNC_MODE=execute
EnvironmentFile=/opt/invol/IA_Prod/.env.local
UMask=0077
PrivateTmp=true
StandardOutput=journal
StandardError=journal

# 安全硬约束：只监听 127.0.0.1（HOST 在 server.ts 中固定）
# Caddy 反代到 127.0.0.1:8080

[Install]
WantedBy=multi-user.target
