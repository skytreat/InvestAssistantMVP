          "date": "2026-10-12",
          "direction": "buy",
          "quantity": 100,
          "price": 20,
          "fee": 0
        }
      ],
      "expected": {
        "totalQuantity": 400,
        "avgCost": 15,
        "totalCostBasis": 6000,
