      "trades": [
        {
          "date": "2026-10-10",
          "direction": "buy",
          "quantity": 100,
          "price": 10,
          "fee": 0
        }
      ],
      "expected": {
        "totalQuantity": 100,
        "avgCost": 10,
        "totalCostBasis": 1000,
        "realizedPnL": 0,
        "totalFee": 0,
        "hasOversell": false,
        "oversellDetail": null
      }
    },
    {
