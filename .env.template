# === InvestAssistant MVP 环境变量模板 ===
# 复制此文件为 .env.local，填入实际值后，.env.local 已在 .gitignore 中
# 用法：cp .env.template .env.local && vim .env.local

# JWT 签名密钥（生成：openssl rand -hex 32）
JWT_SECRET=replace_with_openssl_rand_hex_32_output

# Tushare API Token（tushare.pro 注册后获取）
TUSHARE_TOKEN=your_tushare_token_here

# 数据库路径（默认，一般不需要改）
SQLITE_DB_PATH=/opt/invol/business.db
DUCKDB_PATH=/opt/invol/quotes.duckdb

# 日志级别
LOG_LEVEL=info
