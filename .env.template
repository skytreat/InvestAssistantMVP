# === InvestAssistant MVP 生产环境变量模板 ===
# 生产文件位于 /opt/invol/IA_Prod/.env.local（不要用仓库内 .env.local 覆盖）
# 首次部署时 deploy.sh 会复制本模板并退出；若存在旧 /opt/invol/.env.local，
# 会先复制旧配置并改写路径。填好后重新执行部署。
# 生成 JWT_SECRET：openssl rand -hex 32

# JWT 签名密钥（必填，禁止使用占位值）
JWT_SECRET=replace_with_openssl_rand_hex_32_output

# Tushare API Token（C11/C12 校验使用；生产建议填写）
TUSHARE_TOKEN=your_tushare_token_here

# 数据库路径
SQLITE_DB_PATH=/opt/invol/IA_Prod/data/business.db
DUCKDB_PATH=/opt/invol/IA_Prod/quotes.duckdb
BACKUP_DIR=/opt/invol/IA_Prod/backup

# 自定义插件目录（可选；默认 /opt/invol/IA_Prod/plugins/strategies）
# PLUGIN_ALLOWED_PATH=/opt/invol/IA_Prod/plugins/strategies

# tdx2db 写窗口哨兵（可选；默认 /opt/invol/IA_Prod/.tdx2db-writing）
# TDX2DB_WRITE_SENTINEL=/opt/invol/IA_Prod/.tdx2db-writing

# Fastify 只监听 127.0.0.1；这里只可改端口
PORT=8080

# 行情库（DuckDB）备份开关：默认 true；仅 false 关闭。
# 关闭后只备份 SQLite 业务库；行情库可由 tdx2db 重建，不产 parquet。
# ENABLE_QUOTE_BACKUP=false

# 日志级别
LOG_LEVEL=info
